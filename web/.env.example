# Copy to `.env` on the server and fill in. Never commit the real .env.
# `docker compose` reads this file automatically.

# The domain Caddy will get an HTTPS certificate for. No https://, no slash.
DOMAIN=api.example.com

# Signs login tokens. Generate with:  openssl rand -base64 32
# If this leaks, anyone can mint a token and spend your API credits.
JWT_SECRET=

# --- Paid providers -------------------------------------------------------
# platform.openai.com → API keys
OPENAI_API_KEY=

# elevenlabs.io → Profile → API key
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Keep this on v3. It is the ONLY model here that actually speaks Georgian:
# flash/turbo v2.5 cover ~32 languages and Georgian is not among them, so they
# approximate the script and a native speaker hears it as broken.
#
# The cost is real and known — measured on Georgian, same text and voice:
#   eleven_v3          ~2200-3300ms synth   (correct Georgian)
#   eleven_flash_v2_5  ~250-480ms synth     (unusable Georgian)
# Do not "optimize" this back to flash on latency grounds. That trade was tried
# and rejected: a fast wrong voice is worse than a slow right one. Latency is
# bought back elsewhere (playback that starts on first byte), not here.
ELEVENLABS_MODEL=eleven_v3

# Google Cloud STT (Chirp 2) uses google-service-account.json, NOT a key here.
# This is only for the older /api/transcribe-google route.
GOOGLE_CLOUD_API_KEY=


# --- Tuning (optional, sane defaults in code) -----------------------------
# Global ceiling on paid requests per day — the backstop against a runaway
# bill. Raise once you know your real traffic.
DAILY_REQUEST_CAP=5000
