FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
# tsx is needed by this standalone TypeScript service.
RUN npm ci --include=dev
COPY ws-server.ts tsconfig.json ./
COPY src/stt ./src/stt
COPY src/lib/auth/jwt.ts ./src/lib/auth/jwt.ts
USER node
EXPOSE 3001
HEALTHCHECK --interval=15s --timeout=3s CMD node -e "fetch('http://127.0.0.1:3001/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "--import", "tsx", "ws-server.ts"]
