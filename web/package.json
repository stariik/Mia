{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "ws-dev": "tsx watch ws-server.ts",
    "redis-dev": "redis-cli ping >/dev/null 2>&1 || redis-server --daemonize yes --bind 127.0.0.1 --save \"\" --appendonly no",
    "dev:all": "npm run redis-dev && concurrently -n next,ws -c blue,magenta \"npm run dev\" \"npm run ws-dev\"",
    "test:stt": "node --import tsx --test src/stt/*.test.ts",
    "stt:probe": "node --import tsx scripts/stt-probe.ts",
    "stt:evaluate": "node --import tsx scripts/stt-evaluate.ts",
    "tools:probe": "node --import tsx scripts/tool-probe.ts"
  },
  "dependencies": {
    "@google-cloud/speech": "^7.3.1",
    "@google-cloud/translate": "^9.4.2",
    "@google/genai": "^2.24.0",
    "dotenv": "^17.4.2",
    "next": "16.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "redis": "^6.2.1",
    "ws": "^8.21.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5"
  }
}
