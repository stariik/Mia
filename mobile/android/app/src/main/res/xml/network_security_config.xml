<?xml version="1.0" encoding="utf-8"?>
<!--
  Network security policy for Mia — release builds.

  HTTPS everywhere, no exceptions. The dev-only cleartext allowlist (laptop
  LAN IPs, localhost, emulator host) lives in the debug resource overlay at
  src/debug/res/xml/network_security_config.xml and never ships to users.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
