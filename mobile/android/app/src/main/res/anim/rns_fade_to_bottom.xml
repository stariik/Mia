<?xml version="1.0" encoding="utf-8"?>
<!--Overrides react-native-screens' fade_from_bottom close animation: the
screen fades steadily from the start instead of holding fully opaque for
100ms, and sinks along fast_out_linear_in rather than accelerate_quint. Keep
the 250ms duration in step with rns_no_animation_250.xml.-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">
    <alpha android:fromAlpha="1.0" android:toAlpha="0.0"
        android:interpolator="@android:interpolator/linear"
        android:duration="230"/>
    <translate android:fromYDelta="0%" android:toYDelta="4%"
        android:interpolator="@android:interpolator/fast_out_linear_in"
        android:duration="250"/>
</set>
