{
  "name": "mobile",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "device": "npm run tunnels && react-native run-android",
    "icons": "node scripts/gen-icons.mjs",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "postinstall": "patch-package",
    "start": "expo start --go",
    "test": "jest",
    "tunnels": "adb reverse tcp:8081 tcp:8081 && adb reverse tcp:3002 tcp:3002 && adb reverse tcp:3001 tcp:3001"
  },
  "dependencies": {
    "@notifee/react-native": "^9.1.8",
    "@picovoice/react-native-voice-processor": "^1.2.3",
    "@react-native-async-storage/async-storage": "^3.0.2",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.12",
    "@sentry/react-native": "~7.11.0",
    "expo": "~57.0.25",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-linear-gradient": "~57.0.2",
    "expo-location": "~57.0.20",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-bootsplash": "^7.3.1",
    "react-native-nitro-modules": "^0.35.5",
    "react-native-nitro-sound": "^0.2.14",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-sse": "^1.2.1",
    "react-native-svg": "^15.15.4",
    "react-native-webview": "^13.16.1",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.3",
    "@react-native/eslint-config": "0.86.3",
    "@react-native/jest-preset": "0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@react-native/typescript-config": "0.86.3",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-preset-expo": "~57.0.13",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "patch-package": "^8.0.1",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-bootsplash",
        "typescript",
        "@react-native-async-storage/async-storage"
      ]
    },
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-audio"
        ]
      }
    }
  }
}
