{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "local": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleLocal",
        "withoutCredentials": true
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://192.168.1.35:3002",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "production": {}
  },
  "submit": {
    "production": {}
  }
}
